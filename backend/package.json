{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && xcopy /Y src\\db\\schema.sql dist\\db\\",
    "start": "npm run build && node dist/server.js",
    "serve": "node dist/server.js",
    "test": "vitest run",
    "auth:add-user": "tsx src/auth/add-user-cli.ts",
    "auth:add-user:dist": "node dist/auth/add-user-cli.js",
    "auth:list-users": "tsx src/auth/list-users-cli.ts",
    "auth:list-users:dist": "node dist/auth/list-users-cli.js",
    "classify:chat": "tsx src/chat-import/classify-chat-folders.ts",
    "hash:photos": "tsx src/photos/hash-project-photos-cli.ts",
    "hash:photos:dist": "node dist/photos/hash-project-photos-cli.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "exifr": "^7.1.3",
    "fastify": "^5.6.2",
    "heic-convert": "^2.1.0",
    "playwright-core": "^1.60.0",
    "proj4": "^2.20.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
