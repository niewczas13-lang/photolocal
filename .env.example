PHOTO_LOCAL_PORT=4873
PHOTO_LOCAL_HOST=0.0.0.0
PHOTO_LOCAL_DB=.\data\photo-local.sqlite
PHOTO_LOCAL_LOG=.\logs\app.log
ADRESY_APP_BASE_URL=https://api.adresy.app/api/v1
ADRESY_APP_API_KEY=
ADRESY_APP_REVERSE_RADIUS_METERS=200
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PhotoLocal/0.1 (local reverse geocoding)
# Optional web OAuth; download a Google Web application client JSON to this private path.
# Existing desktop credentials/token remain usable until web OAuth is configured.
# GOOGLE_CHAT_CREDENTIALS_FILE=C:/PhotoLocal/pobierzchat/credentials.json
# GOOGLE_CHAT_TOKEN_FILE=C:/PhotoLocal/pobierzchat/token.json
GOOGLE_CHAT_OAUTH_REDIRECT_URI=
# GOOGLE_CHAT_DOWNLOAD_ROOT=C:/PhotoLocal/pobierzchat/pobrane_zdjecia
# Leave unset to keep the job snapshot beside PHOTO_LOCAL_DB.
# GOOGLE_CHAT_JOB_STATE_FILE=C:/PhotoLocal/data/google-chat-download.json
# Leave unset on Windows to discover mapped drives. Linux accepts explicit mount roots.
# PHOTO_LOCAL_SHARED_ROOTS='[{"path":"/photos","label":"Zdjęcia"}]'
GOOGLE_CHAT_BROWSER_PATH=
GOOGLE_CHAT_INVITE_DEBUG_PORT=9222
GOOGLE_CHAT_INVITE_HEADLESS=false
