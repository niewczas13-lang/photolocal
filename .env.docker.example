# Copy to .env.docker, then use: docker compose --env-file .env.docker ...
# All paths below are isolated staging copies. Never share writable production directories.
# On Windows, use forward slashes in absolute bind paths, e.g. C:/PhotoLocal-staging/data.
PHOTO_LOCAL_BIND_IP=127.0.0.1
PHOTO_LOCAL_HOST_PORT=4874
PHOTO_LOCAL_IMAGE_TAG=staging
PHOTO_LOCAL_DATA_DIR=./docker-data/data
PHOTO_LOCAL_GOOGLE_DIR=./docker-data/google
PHOTO_LOCAL_DOWNLOADS_DIR=./docker-data/downloads
PHOTO_LOCAL_PHOTOS_DIR=./docker-data/photos
PHOTO_LOCAL_SHARED_ROOTS='[{"path":"/photos","label":"Zdjęcia"}]'

# Leave disabled for the initial isolated test. Use a callback routed to THIS instance.
# For browser tests on the server: http://localhost:4874/api/google-chat/auth/callback
# For production: https://romek.pawelzykubek.pl/api/google-chat/auth/callback
# Register the exact URI on the Google Web application OAuth client before enabling it.
GOOGLE_CHAT_OAUTH_REDIRECT_URI=
OLLAMA_URL=http://host.docker.internal:11434
