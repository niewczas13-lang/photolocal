# Send only build inputs, never the repository's local datasets or untracked tools.
**
!package.json
!package-lock.json
!backend/
!backend/package.json
!backend/tsconfig.json
!backend/src/
!backend/src/**
!frontend/
!frontend/package.json
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!pobierzchat/
!pobierzchat/chat.py
!pobierzchat/requirements.txt
!scripts/
!scripts/copy-schema.mjs
!scripts/migrate-docker-data.mjs

# Keep sensitive/runtime files excluded even if placed under an allowed source directory.
**/node_modules
**/dist
**/coverage
**/__pycache__
**/*.pyc
**/*.tsbuildinfo
**/*.log
**/*.pid
**/*.sqlite*
**/*.db
**/*.gpkg
**/*.jsonl
**/*.migration.json
**/.env
**/.env.*
**/credentials*.json
**/token*.json
**/*client_secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/data
**/logs
**/pobrane_zdjecia
**/google-chat-browser-profile
docker-data
backups
docs
baseline-tests.log
